.env
.env.*
!.env.example
!.env.*.example
frontend/.env.local
backend/.env
backend/.env.backup
backend/.env.production

# ── Bases de données locales ─────────────────────────────
pgdata/
*.sqlite
*.sqlite3
*.sqlite-journal
backend/database/*.sqlite*

